<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="crmjuridico.viewGUI.LoginController"
           style="-fx-background-color: #2C3E50;">
    <children>
        <VBox alignment="TOP_CENTER" maxWidth="400" prefHeight="380" prefWidth="340" spacing="15"
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 20, 0, 0, 5);">
            <padding>
                <Insets top="50" bottom="50" left="40" right="40"/>
            </padding>
            <children>
                <Label text="CRM Jurídico" style="-fx-text-fill: #2C3E50; -fx-font-weight: bold;">
                    <font>
                        <Font size="26.0"/>
                    </font>
                </Label>
                <Label text="Sistema de Gestão de Advocacia"
                       style="-fx-text-fill: #7F8C8D;">
                    <font>
                        <Font size="12.0"/>
                    </font>
                </Label>
                <TextField fx:id="usernameField" maxWidth="1.7976931348623157E308"
                           promptText="Username"
                           style="-fx-background-color: #F5F6FA; -fx-border-color: #E0E0E0; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 10; -fx-font-size: 13px;"/>
                <PasswordField fx:id="passField" maxWidth="1.7976931348623157E308"
                               promptText="Password"
                               style="-fx-background-color: #F5F6FA; -fx-border-color: #E0E0E0; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 10; -fx-font-size: 13px;"/>
                <Button fx:id="loginButton" maxWidth="1.7976931348623157E308"
                        mnemonicParsing="false" onAction="#handleLogin" text="Entrar"
                        style="-fx-background-color: #2C3E50; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12; -fx-background-radius: 5; -fx-cursor: hand; -fx-font-weight: bold;"
                        defaultButton="true" />
            </children>
        </VBox>
    </children>
</StackPane>
